# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Which provider supplies upcoming fixtures: football_data (default) | api_football
FIXTURE_PROVIDER=football_data

# Which provider supplies first-half O/U 0.5 odds: none (default) | manual_csv | api
ODDS_PROVIDER=none

# Only needed if an API provider is selected (not implemented yet).
API_FOOTBALL_KEY=
ODDS_API_KEY=
